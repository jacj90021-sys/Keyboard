<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules. The keyboard deliberately keeps NO cloud backup: a stale
   "last crash" report or a half-finished onboarding flag restored onto a fresh
   install would surface as a bogus error popup and skip setup steps.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="last_crash.txt"/>
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
