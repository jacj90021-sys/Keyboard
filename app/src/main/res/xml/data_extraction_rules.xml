<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+). Same policy as backup_rules.xml: nothing
   that carries a stale crash report or onboarding state may leave the device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="last_crash.txt"/>
        <exclude domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="last_crash.txt"/>
        <exclude domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
